# =============================================================
# AI LINE Inquiry Assistant / 環境変数サンプル
# 実際の値は .env.local に記載してください（.env.local は Git 管理対象外）
# このファイルにはダミー値・空値のみを記載し、実キーは絶対に書かないでください
# =============================================================

# ------ AI プロバイダー ------
# mock   : APIキー不要のデモ用 Mock AI（既定値）
# openai : OpenAI API を利用（OPENAI_API_KEY が無い場合は自動で mock にフォールバック）
AI_PROVIDER=mock

# OpenAI（AI_PROVIDER=openai のときのみ使用）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Azure OpenAI / プロキシ経由で利用する場合のみ指定（既定: https://api.openai.com/v1）
OPENAI_BASE_URL=

# ------ LINE Messaging API（未設定でもアプリは動作します） ------
# 設定すると /api/webhook/line が署名検証つきで受信を受け付けます
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ------ 担当者通知（未設定の場合はデモ通知＝外部送信なし） ------
SLACK_WEBHOOK_URL=
